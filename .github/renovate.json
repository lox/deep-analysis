{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update default OpenAI GPT model strings.",
      "managerFilePatterns": [
        "/(^|/)main\\.go$/",
        "/(^|/)internal/agent/scout\\.go$/"
      ],
      "matchStrings": [
        "renovate: depName=openai/gpt-latest[^\\n]*\\n[^\\n]*\"(?<currentValue>gpt-[0-9]+(?:\\.[0-9]+)?)\""
      ],
      "depNameTemplate": "openai/gpt-latest",
      "datasourceTemplate": "custom.openai-latest-gpt",
      "versioningTemplate": "regex:^gpt-(?<major>\\d+)(?:\\.(?<minor>\\d+))?$"
    },
    {
      "customType": "regex",
      "description": "Update the default OpenAI GPT Sol researcher model.",
      "managerFilePatterns": [
        "/(^|/)internal/client/deepanalysis\\.go$/"
      ],
      "matchStrings": [
        "renovate: depName=openai/gpt-latest-sol[^\\n]*\\n[^\\n]*\"(?<currentValue>gpt-[0-9]+(?:\\.[0-9]+)?-sol)\""
      ],
      "depNameTemplate": "openai/gpt-latest-sol",
      "datasourceTemplate": "custom.openai-latest-gpt",
      "versioningTemplate": "regex:^gpt-(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?<compatibility>-sol)$"
    }
  ],
  "customDatasources": {
    "openai-latest-gpt": {
      "defaultRegistryUrlTemplate": "https://developers.openai.com/api/docs/guides/latest-model.md",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $trim($replace(releases.version[$match($, /^\\s*model:\\s*gpt-/)][0], /^\\s*model:\\s*/, \"\"))}],\"homepage\":\"https://developers.openai.com/api/docs/guides/latest-model\"}"
      ]
    }
  },
  "packageRules": [
    {
      "matchPackageNames": ["openai/gpt-latest", "openai/gpt-latest-sol"],
      "groupName": "OpenAI model defaults"
    }
  ]
}
